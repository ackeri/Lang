-- Milestone 1 tour: preposition labels, subjects, overloading, function values.

fn square object n is Int -> Int:
    return multiply n by n

fn greet:
    print "hello, world"

fn twice object f is (fn object n is Int -> Int); to x is Int -> Int:
    return f (f x)

fn area of w is Int; by h is Int -> Int:
    return multiply w by h

greet
print (3 add 4)
print (add 3 4)
print (subtract 3 from 10)
print (square 5)
print (twice square to 3)
print (area of 3 by 4)
print (area by 4 of 3)
